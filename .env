# Database connection used by the FastAPI app
# Locally (Docker Compose): DB_HOST is the MySQL *service name* "db"
# On AWS later: DB_HOST becomes the RDS endpoint
DB_HOST=
DB_PORT=3306
DB_NAME=taskdb
DB_USER=taskuser
DB_PASSWORD=ChangeMe_StrongPassword123

# Used ONLY by the local MySQL container (not needed with RDS)
DB_ROOT_PASSWORD=ChangeMe_RootPassword123

# Set to "false" to skip table creation at startup (e.g. DR read replica)
AUTO_CREATE_TABLES=true
